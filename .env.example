# This server's public address and a long random secret (openssl rand -base64 32).
# The secret also encrypts stored submissions: changing it makes them unreadable.
BETTER_AUTH_URL=https://forms.example.com
BETTER_AUTH_SECRET=

# Optional: admin sign-in with GitHub (callback: <BETTER_AUTH_URL>/api/auth/callback/github).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional: admin sign-in with Google (redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: a Cloudflare Turnstile check on the sign-in and sign-up forms.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Email for new submissions and admin invites (smtps://user:pass@host:465 or smtp://user:pass@host:587).
# Without it, emails are printed to the server console.
SMTP_URL=
EMAIL_FROM=Gitupcms Forms <noreply@example.com>

# 1 when a reverse proxy (Caddy, nginx) sets X-Forwarded-For: rate limits then count per visitor.
# Leave empty when the app is reachable directly, or visitors could fake their address.
TRUST_PROXY=

# Where the SQLite database lives (default data/gitupcms-forms.db); uploaded files go in a "files" folder next to it.
DB_PATH=
FILES_DIR=
# Largest submission with files, in MB (default 10).
MAX_UPLOAD_MB=

# Hosted (cloud) servers only; leave empty when self-hosting.
# Submissions (not spam) per calendar month across every form; past it, posts are refused.
MONTHLY_SUBMISSION_LIMIT=
# How many forms can exist.
MAX_FORMS=
# 1: a small "Sent with Gitupcms Forms" line on thank-you pages and emails.
BRANDING=
