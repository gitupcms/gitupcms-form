---
import Base from "./Base.astro";
import { Button } from "@/components/ui/button";
import { tabList, tabTrigger } from "@/components/ui/island";
import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from "@/components/ui/select";
import { FolderKanban, Gauge, Inbox, KeyRound, LayoutList, UserSearch, Users } from "@lucide/astro";
import { workspaces } from "@/plugins/forms/lib/forms";

interface Props {
  title?: string;
}
const { title } = Astro.props;
const { admin, workspace } = Astro.locals;
const all = workspaces();
const path = Astro.url.pathname;
const nav = [
  ["/", LayoutList, "Forms"],
  ["/inbox", Inbox, "Inbox"],
  ["/workspaces", FolderKanban, "Workspaces"],
  ["/usage", Gauge, "Usage"],
  ["/api-keys", KeyRound, "API"],
  ["/data-requests", UserSearch, "Data requests"],
  ["/team", Users, "Team"],
] as const;
const active = (href: string) => (href === "/" ? path === "/" || path.startsWith("/forms") : path.startsWith(href));
---

<Base title={title}>
  <header class="border-b">
    <div class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-4 py-3">
      <div class="flex items-center gap-3">
        <a href="/" class="flex items-center gap-2 font-medium"><Inbox class="size-4" /> Gitupcms Forms</a>
        <Select defaultValue={workspace.id} size="sm" data-workspace>
          <SelectTrigger size="sm" aria-label="Workspace"><SelectValue /></SelectTrigger>
          <SelectContent>{all.map((w) => <SelectItem value={w.id}>{w.name}</SelectItem>)}</SelectContent>
        </Select>
      </div>
      <div class="flex flex-wrap items-center gap-3 text-sm">
        <span class="text-muted-foreground hidden sm:inline">{admin.email}</span>
        <Button size="sm" variant="outline" data-sign-out>Sign out</Button>
      </div>
    </div>
  </header>
  <main class="mx-auto flex max-w-6xl flex-col gap-6 px-4 py-6">
    <nav class={tabList + " max-w-full overflow-x-auto"} aria-label="Sections">
      {
        nav.map(([href, Icon, label]) => (
          <a href={href} class={tabTrigger} data-state={active(href) ? "active" : undefined} aria-current={active(href) ? "page" : undefined}>
            <Icon /> {label}
          </a>
        ))
      }
    </nav>
    <div><slot /></div>
  </main>
</Base>

<script>
  import { post } from "@/lib/post";
  document.querySelector("[data-workspace]")!.addEventListener("select:change", async (e) => {
    await post("/api/workspaces", { action: "switch", id: (e as CustomEvent<{ value: string }>).detail.value });
    location.href = "/";
  });
  document.querySelector("[data-sign-out]")?.addEventListener("click", async () => {
    await fetch("/api/auth/sign-out", { method: "POST" });
    location.href = "/login";
  });
</script>
