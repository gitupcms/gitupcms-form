---
import { button, inputClass, sectionLabel } from "@/components/ui/island";
import { appOrigin } from "@/lib/admin";
import { FIELD_TYPES } from "@/plugins/forms/lib/config";
import type { Form } from "@/plugins/forms/lib/forms";

interface Props {
  form: Form;
}
const { form } = Astro.props;
const b = form.config.builder;
const label = "flex flex-col gap-1 text-sm";
const hint = "text-muted-foreground text-xs";
const hosted = `${appOrigin}/f/${form.key}`;
const embed = `<div data-gitupcms-form="${form.key}"></div>\n<script async src="${appOrigin}/f/${form.key}/embed.js"></script>`;
---

<div class="flex flex-col gap-6">
  <p class="text-muted-foreground text-sm">
    No HTML form yet? Build one here and put it on any site with two lines, or share its own page. Posts are checked against these fields. A hand-written form
    keeps working while this is off.
  </p>

  <section class="flex flex-col gap-4 rounded-lg border p-4">
    <label class="flex items-start gap-3 text-sm">
      <input type="checkbox" class="mt-1 size-4" data-b="enabled" checked={b.enabled} />
      <span class="flex flex-col gap-1">Use this form <span class={hint}>Turns on the embed script, the hosted page and the field checks.</span></span>
    </label>
    <div class="grid gap-4 sm:grid-cols-2">
      <label class={label}>Title <input class={inputClass} data-b="title" value={b.title} placeholder="Contact us" /></label>
      <label class={label}>Button text <input class={inputClass} data-b="submit" value={b.submit} /></label>
    </div>
    <label class={label}>Text above the fields <textarea class={inputClass + " min-h-16 py-2"} data-b="description">{b.description}</textarea></label>
    <label class={label}>Thank-you message <input class={inputClass} data-b="success" value={b.success} /></label>
  </section>

  <div class="flex flex-col gap-3" data-fields></div>
  <div class="flex flex-wrap items-center gap-3">
    <button class={button("outline")} data-add>Add a field</button>
    <button class={button("primary")} data-save-builder>Save</button>
    <span class="text-sm" role="status" data-status></span>
  </div>

  {
    b.enabled && (
      <section class="flex flex-col gap-3 rounded-lg border p-4">
        <h2 class={sectionLabel}>Put it on your site</h2>
        <pre class="bg-muted overflow-x-auto rounded-lg p-3 text-xs whitespace-pre-wrap"><code>{embed}</code></pre>
        <p class={hint}>
          Or link to its own page: <a class="underline" href={hosted} target="_blank">{hosted}</a>. Allowed sites (Security tab) still apply to where it may be posted from.
        </p>
        <iframe src={`/f/${form.key}`} title="Preview" class="h-[32rem] w-full rounded-lg border bg-white" />
      </section>
    )
  }
</div>

<template data-field>
  <fieldset class="flex flex-col gap-2 rounded-lg border p-3">
    <div class="flex flex-wrap items-center gap-2">
      <select class={inputClass + " w-auto!"} data-f="type" aria-label="Type">{FIELD_TYPES.map((t) => <option value={t}>{t}</option>)}</select>
      <input class={inputClass + " max-w-48"} data-f="label" placeholder="Label" aria-label="Label" />
      <input class={inputClass + " max-w-40 font-mono"} data-f="name" placeholder="name" aria-label="Field name" />
      <label class="flex items-center gap-2 text-sm"><input type="checkbox" class="size-4" data-f="required" /> Required</label>
      <span class="flex-1"></span>
      <button type="button" class={button("ghost", "sm")} data-move="-1" aria-label="Move up">↑</button>
      <button type="button" class={button("ghost", "sm")} data-move="1" aria-label="Move down">↓</button>
      <button type="button" class={button("ghost", "sm")} data-remove>Remove</button>
    </div>
    <input class={inputClass} data-f="placeholder" placeholder="Placeholder (optional)" aria-label="Placeholder" />
    <textarea class={inputClass + " min-h-16 py-2"} data-f="options" placeholder="Options, one per line (select only)" aria-label="Options"></textarea>
  </fieldset>
</template>

<script define:vars={{ key: form.key, saved: b.fields }}>
  const list = document.querySelector("[data-fields]");
  const tpl = document.querySelector("template[data-field]");
  const status = document.querySelector("[data-status]");
  const slug = (s) => s.toLowerCase().replace(/[^a-z0-9]+/g, "_").replace(/^_+|_+$/g, "").slice(0, 60);

  const add = (f = { type: "text", name: "", label: "", required: false, placeholder: "", options: [] }) => {
    const el = tpl.content.firstElementChild.cloneNode(true);
    const v = (k) => el.querySelector(`[data-f="${k}"]`);
    for (const input of el.querySelectorAll("[data-f]")) {
      const value = f[input.dataset.f];
      input.type === "checkbox" ? (input.checked = value) : (input.value = Array.isArray(value) ? value.join("\n") : value);
    }
    const showOptions = () => (v("options").hidden = v("type").value !== "select");
    v("type").onchange = showOptions;
    showOptions();
    // The field name follows the label until someone edits it.
    v("label").oninput = () => {
      if (!v("name").dataset.touched) v("name").value = slug(v("label").value);
    };
    v("name").oninput = () => (v("name").dataset.touched = "1");
    if (f.name) v("name").dataset.touched = "1";
    el.querySelector("[data-remove]").onclick = () => el.remove();
    el.querySelectorAll("[data-move]").forEach((b) => (b.onclick = () => (b.dataset.move === "-1" ? el.previousElementSibling?.before(el) : el.nextElementSibling?.after(el))));
    list.append(el);
  };

  (saved.length ? saved : [
    { type: "text", name: "name", label: "Name", required: true, placeholder: "", options: [] },
    { type: "email", name: "email", label: "Email", required: true, placeholder: "", options: [] },
    { type: "textarea", name: "message", label: "Message", required: true, placeholder: "", options: [] },
  ]).forEach(add);
  document.querySelector("[data-add]").onclick = () => add();

  document.querySelector("[data-save-builder]").onclick = async () => {
    const builder = Object.fromEntries([...document.querySelectorAll("[data-b]")].map((i) => [i.dataset.b, i.type === "checkbox" ? i.checked : i.value]));
    builder.fields = [...list.children].map((el) =>
      Object.fromEntries([...el.querySelectorAll("[data-f]")].map((i) => [i.dataset.f, i.type === "checkbox" ? i.checked : i.dataset.f === "options" ? i.value.split("\n") : i.value])),
    );
    const res = await fetch(`/api/forms/${key}`, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ action: "update", config: { builder } }) });
    const json = await res.json().catch(() => ({ error: "Unexpected response." }));
    if (res.ok) return location.reload();
    Object.assign(status, { className: "text-destructive text-sm", textContent: json.error });
  };
</script>
