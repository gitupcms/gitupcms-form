---
import { tabList, tabTrigger } from "@/components/ui/island";
import { appOrigin } from "@/lib/admin";
import { counts, type Form } from "@/plugins/forms/lib/forms";
import { ChartColumn, Code, GitBranch, Inbox, Send, Settings, Shield } from "@lucide/astro";

interface Props {
  form: Form;
  tab: string | null;
}
const { form, tab } = Astro.props;
const n = counts(form.key);
const tabs = [
  ["inbox", Inbox, `Submissions${n.unread ? ` (${n.unread} new)` : ""}`],
  ["analytics", ChartColumn, "Analytics"],
  ["setup", Code, "Setup"],
  ["delivery", Send, "Delivery"],
  ["rules", GitBranch, `Rules${form.config.rules.length ? ` (${form.config.rules.length})` : ""}`],
  ["security", Shield, "Security"],
  ["settings", Settings, "Settings"],
] as const;
---

<div class="flex flex-col gap-4">
  <div>
    <a href="/" class="text-muted-foreground hover:text-foreground text-xs">← Forms</a>
    <h1 class="flex items-center gap-2 text-lg font-medium tracking-tight">
      {form.name}
      {!form.config.active && <span class="rounded-full bg-amber-500/15 px-2 py-0.5 text-xs font-normal text-amber-700 dark:text-amber-300">Paused</span>}
    </h1>
    <p class="text-muted-foreground font-mono text-xs">POST {appOrigin}/f/{form.key}</p>
  </div>
  <nav class={tabList + " max-w-full overflow-x-auto"} aria-label="Form">
    {
      tabs.map(([id, Icon, label]) => (
        <a href={`/forms/${form.key}?tab=${id}`} class={tabTrigger} data-state={tab === id ? "active" : undefined} aria-current={tab === id ? "page" : undefined}>
          <Icon /> {label}
        </a>
      ))
    }
  </nav>
</div>
