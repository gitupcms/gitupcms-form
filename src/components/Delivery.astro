---
import { Checkbox } from "@/components/ui/checkbox";
import { Input } from "@/components/ui/input";
import { Textarea } from "@/components/ui/textarea";
import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from "@/components/ui/select";
import { Button } from "@/components/ui/button";
import { button, sectionLabel } from "@/components/ui/island";
import { SHEETS_SCRIPT } from "@/plugins/forms/lib/channels";
import type { Form } from "@/plugins/forms/lib/forms";

interface Props {
  form: Form;
}
const { form } = Astro.props;
const c = form.config;
const label = "flex flex-col gap-1 text-sm";
const hint = "text-muted-foreground text-xs";
const card = "flex flex-col gap-4 rounded-lg border p-4";
const secret = (saved: string) => (saved ? "Saved (leave empty to keep it)" : "");
---

<div class="flex flex-col gap-6">
  <form class={card} data-save>
    <h2 class="text-sm font-medium">Email</h2>
    <label class={label}>
      Send submissions to
      <Input name="recipients" value={form.recipients} placeholder="you@example.com, team@example.com" />
      <span class={hint}>Comma-separated. Replies go to the sender. Leave empty for no email. Rules can send some submissions elsewhere.</span>
    </label>
    <div class="flex items-start gap-3 text-sm">
      <Checkbox id="cb-config-autoReply-enabled" name="config.autoReply.enabled" checked={c.autoReply.enabled} class="mt-0.5" />
      <label for="cb-config-autoReply-enabled" class="flex flex-col gap-1">
        Auto-reply to the sender
        <span class={hint}>Goes to the form's <code>email</code> (or <code>_replyto</code>) field, at most once a day per address. Not sent for spam.</span>
      </label>
    </div>
    <label class={label}>
      Intro text
      <Textarea class="min-h-20" name="config.email.intro" maxlength="2000" placeholder="Shown at the top of every notification email, e.g. who should answer it.">{c.email.intro}</Textarea>
    </label>
    <label class={label}>
      Grouping
<Select name="config.email.digest" defaultValue={c.email.digest} class="w-full" disabled={!c.archive}>
        <SelectTrigger class="w-full"><SelectValue /></SelectTrigger>
        <SelectContent>{[["", "One email per submission"], ["hourly", "One email an hour with everything new"], ["daily", "One email a day with everything new"]].map(([v, l]) => <SelectItem value={v}>{l}</SelectItem>)}</SelectContent>
      </Select>
      <span class={hint}>{c.archive ? "Channels, webhooks and the auto-reply still go out at once. Send again from the inbox emails one right away." : "Needs stored submissions (Settings)."}</span>
    </label>
    <label class={label}>Auto-reply subject <Input name="config.autoReply.subject" value={c.autoReply.subject} maxlength="200" /></label>
    <label class={label}>
      Auto-reply text
      <Textarea class="min-h-32" name="config.autoReply.body">{c.autoReply.body}</Textarea>
      <span class={hint}><code>{"{{name}}"}</code> puts in a field's value (shortened, links removed so the reply cannot carry spam).</span>
    </label>
    <div class="flex items-center gap-3">
      <Button type="submit">Save</Button>
      <button type="button" class={button("outline")} data-preview>Preview email</button>
      <span role="status" data-status></span>
    </div>
    <iframe class="hidden h-80 w-full rounded-lg border bg-white" sandbox="" title="Notification email preview" data-preview-frame></iframe>
  </form>

  <form class={card} data-save>
    <h2 class="text-sm font-medium">Webhook</h2>
    <label class={label}>
      Address
      <Input name="webhookUrl" value={form.webhookUrl} placeholder="https://hooks.example.com/forms" />
      <span class={hint}>Gets each submission as JSON (not spam), signed with the secret below; a failed post is tried once more.</span>
    </label>
    <label class={label}>
      Authentication
<Select name="config.webhookAuth.kind" defaultValue={c.webhookAuth.kind} class="w-full">
        <SelectTrigger class="w-full"><SelectValue /></SelectTrigger>
        <SelectContent>{[["", "None (signature only)"], ["bearer", "Bearer token"], ["basic", "Basic (user:password)"], ["header", "Custom header"]].map(([v, l]) => <SelectItem value={v}>{l}</SelectItem>)}</SelectContent>
      </Select>
    </label>
    <label class={label}>Header name <Input name="config.webhookAuth.header" value={c.webhookAuth.header} placeholder="Only for a custom header, e.g. X-Api-Key" /></label>
    <label class={label}>Value <Input type="password" name="config.webhookAuth.value" placeholder={secret(c.webhookAuth.value) || "The token, user:password or header value"} autocomplete="off" /></label>
    <div class="flex items-center gap-3"><Button type="submit">Save</Button><span role="status" data-status></span></div>
  </form>

  <section class={card}>
    <h2 class={sectionLabel}>Webhook signing secret</h2>
    <p class={hint}>
      The <code>X-Gitupcms-Signature</code> header is <code>t=&lt;unix time&gt;,v1=&lt;hex HMAC-SHA256 of "t.body"&gt;</code>. Recompute it with this secret and refuse old
      timestamps.
    </p>
    <div class="flex items-center gap-2">
      <Input class="font-mono" type="password" value={form.webhookSecret} readonly aria-label="Webhook secret" data-secret />
      <button class={button("outline", "sm")} data-reveal>Show</button>
      <button class={button("outline", "sm")} data-rotate>New secret</button>
    </div>
  </section>

  <form class={card} data-save>
    <h2 class="text-sm font-medium">Chat</h2>
    <p class={hint}>Each submission (not spam) is posted as a short message. Leave a box empty to turn that one off.</p>
    <label class={label}>
      Slack incoming webhook
      <Input name="config.slack" value={c.slack} placeholder="https://hooks.slack.com/services/…" />
      <span class={hint}>Slack: Apps → Incoming Webhooks → Add to a channel.</span>
    </label>
    <label class={label}>
      Discord webhook
      <Input name="config.discord" value={c.discord} placeholder="https://discord.com/api/webhooks/…" />
      <span class={hint}>Discord: channel settings → Integrations → Webhooks.</span>
    </label>
    <div class="grid gap-4 sm:grid-cols-2">
      <label class={label}>Telegram bot token <Input type="password" name="config.telegram.token" placeholder={secret(c.telegram.token) || "123456:ABC-… from @BotFather"} autocomplete="off" /></label>
      <label class={label}>Telegram chat ID <Input name="config.telegram.chatId" value={c.telegram.chatId} placeholder="-1001234567890" /></label>
    </div>
    <div class="flex items-center gap-3"><Button type="submit">Save</Button><span role="status" data-status></span></div>
  </form>

  <form class={card} data-save>
    <h2 class="text-sm font-medium">Spreadsheets and databases</h2>
    <label class={label}>
      Google Sheets script address
      <Input name="config.sheets" value={c.sheets} placeholder="https://script.google.com/macros/s/…/exec" />
      <span class={hint}>In the sheet: Extensions → Apps Script, paste the script below, Deploy → Web app (anyone may access), copy its address here. New fields become new columns.</span>
    </label>
    <details class="text-sm">
      <summary class="cursor-pointer">The script</summary>
      <pre class="bg-muted mt-2 overflow-x-auto rounded-lg p-3 text-xs"><code>{SHEETS_SCRIPT}</code></pre>
    </details>
    <div class="grid gap-4 sm:grid-cols-2">
      <label class={label}>Notion integration token <Input type="password" name="config.notion.token" placeholder={secret(c.notion.token) || "ntn_… or secret_…"} autocomplete="off" /></label>
      <label class={label}>Notion database (link or ID) <Input name="config.notion.database" value={c.notion.database} /></label>
    </div>
    <p class={hint}>Notion: create an integration, then share the database with it (••• → Connections). The first field becomes the page title.</p>
    <div class="grid gap-4 sm:grid-cols-3">
      <label class={label}>Airtable token <Input type="password" name="config.airtable.token" placeholder={secret(c.airtable.token) || "pat…"} autocomplete="off" /></label>
      <label class={label}>Base ID <Input name="config.airtable.base" value={c.airtable.base} placeholder="app…" /></label>
      <label class={label}>Table <Input name="config.airtable.table" value={c.airtable.table} placeholder="Submissions" /></label>
    </div>
    <p class={hint}>Airtable: a personal access token with data.records:write on the base. Name the columns like the form's fields (name or Name); fields without a column are left out.</p>
    <div class="flex items-center gap-3"><Button type="submit">Save</Button><span role="status" data-status></span></div>
  </form>

  <form class={card} data-save>
    <h2 class="text-sm font-medium">Zapier and Mailchimp</h2>
    <label class={label}>
      Zapier webhook
      <Input name="config.zapier" value={c.zapier} placeholder="https://hooks.zapier.com/hooks/catch/…" />
      <span class={hint}>In a Zap: trigger "Webhooks by Zapier" → Catch Hook, copy its address here. Each field arrives on its own.</span>
    </label>
    <div class="grid gap-4 sm:grid-cols-3">
      <label class={label}>Mailchimp API key <Input type="password" name="config.mailchimp.key" placeholder={secret(c.mailchimp.key) || "…-us21"} autocomplete="off" /></label>
      <label class={label}>Audience ID <Input name="config.mailchimp.audience" value={c.mailchimp.audience} placeholder="a1b2c3d4e5" /></label>
      <label class={label}>Only when this field is filled <Input name="config.mailchimp.field" value={c.mailchimp.field} placeholder="newsletter" /></label>
    </div>
    <p class={hint}>
      Mailchimp: the sender's email joins the audience as pending; Mailchimp asks them to confirm. Put a newsletter checkbox in the form and its name above, so only people who
      tick it are asked. API key: Profile → Extras → API keys. Audience ID: Audience → Settings → Audience name and defaults. Send from your own domain (Account → Domains,
      verify and authenticate it); with a Gmail or other free address, the confirmation emails often land in spam.
    </p>
    <div class="flex items-center gap-3"><Button type="submit">Save</Button><span role="status" data-status></span></div>
  </form>
</div>

<script define:vars={{ key: form.key }}>
  document.querySelector("[data-preview]").addEventListener("click", async () => {
    const res = await fetch(`/api/forms/${key}`, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ action: "preview-email" }) });
    const frame = document.querySelector("[data-preview-frame]");
    frame.srcdoc = (await res.json()).data?.html ?? "Could not load the preview.";
    frame.classList.remove("hidden");
  });
  const secret = document.querySelector("[data-secret]");
  document.querySelector("[data-reveal]").addEventListener("click", (e) => {
    secret.type = secret.type === "password" ? "text" : "password";
    e.target.textContent = secret.type === "password" ? "Show" : "Hide";
  });
  document.querySelector("[data-rotate]").addEventListener("click", async (e) => {
    e.target.disabled = true;
    await fetch(`/api/forms/${key}`, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ action: "rotate-secret" }) });
    location.reload();
  });
</script>
