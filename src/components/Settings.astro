---
import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from "@/components/ui/select";
import { Button } from "@/components/ui/button";
import { button, inputClass, sectionLabel } from "@/components/ui/island";
import { RETENTION_DAYS, SPAM_DAYS, workspaces, type Form } from "@/plugins/forms/lib/forms";

interface Props {
  form: Form;
}
const { form } = Astro.props;
const label = "flex flex-col gap-1 text-sm";
const hint = "text-muted-foreground text-xs";
---

<div class="flex flex-col gap-6">
  <form class="flex flex-col gap-4 rounded-lg border p-4" data-save="reload">
    <label class="flex items-start gap-3 text-sm">
      <input type="checkbox" class="mt-1 size-4" name="config.active" checked={form.config.active} />
      <span class="flex flex-col gap-1">
        Accept submissions
        <span class={hint}>Turn off to pause the form: posts get "not accepting submissions" and nothing is stored.</span>
      </span>
    </label>
    <label class={label}>Name <input class={inputClass} name="name" value={form.name} required maxlength="100" /></label>
    <label class={label}>
      Workspace
<Select name="workspaceId" defaultValue={form.workspaceId} class="w-full">
        <SelectTrigger class="w-full"><SelectValue /></SelectTrigger>
        <SelectContent>{workspaces().map((w) => <SelectItem value={w.id}>{w.name}</SelectItem>)}</SelectContent>
      </Select>
      <span class={hint}>Moving keeps the form's address, settings and submissions.</span>
    </label>
    <label class={label}>
      After sending, go to
      <input class={inputClass} name="redirect" value={form.redirect} placeholder="https://example.com/thanks" />
      <span class={hint}>Empty: the form's <code>_redirect</code> field on the same site, else a plain thank-you page.</span>
    </label>
    <label class={label}>
      Keep submissions
<Select name="retentionDays" defaultValue={String(form.retentionDays)} class="w-full">
        <SelectTrigger class="w-full"><SelectValue /></SelectTrigger>
        <SelectContent>{RETENTION_DAYS.map((d) => <SelectItem value={String(d)}>{d ? `${d} days, then delete them` : "Until I delete them"}</SelectItem>)}</SelectContent>
      </Select>
      <span class={hint}>Old submissions and their files are deleted for good. Spam is always deleted after {SPAM_DAYS} days.</span>
    </label>
    <label class="flex items-start gap-3 text-sm">
      <input type="checkbox" class="mt-1 size-4" name="config.archive" checked={form.config.archive} />
      <span class="flex flex-col gap-1">
        Store submissions
        <span class={hint}>Off: each submission is only emailed and sent to your channels, then deleted. Nothing stays in the inbox, uploaded files are not kept and emails have no inbox links. Analytics still counts them.</span>
      </span>
    </label>
    <div class="flex items-center gap-3">
      <Button type="submit">Save</Button>
      <span class="text-sm" role="status" data-status></span>
    </div>
  </form>

  <section class="border-destructive/40 flex flex-col gap-3 rounded-lg border p-4">
    <h2 class={sectionLabel}>Delete form</h2>
    <p class={hint}>Deletes the form, every submission and every uploaded file. Posts to its address stop working.</p>
    <div class="flex items-center gap-2">
      <input class={inputClass} placeholder={`Type ${form.name} to confirm`} aria-label="Form name" data-confirm />
      <button class={button("destructive")} data-delete>Delete</button>
    </div>
  </section>
</div>

<script define:vars={{ key: form.key }}>
  const confirmInput = document.querySelector("[data-confirm]");
  document.querySelector("[data-delete]").addEventListener("click", async () => {
    const res = await fetch(`/api/forms/${key}`, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ action: "delete-form", confirm: confirmInput.value }) });
    if (res.ok) return (location.href = "/");
    const json = await res.json().catch(() => ({ error: "Unexpected response." }));
    confirmInput.setCustomValidity(json.error);
    confirmInput.reportValidity();
    confirmInput.setCustomValidity("");
  });
</script>
