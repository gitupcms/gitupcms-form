---
import { button, inputClass } from "@/components/ui/island";
import { counts, forms, PAGE, PER_PAGE, submissions, type Form, type Submission, type View } from "@/plugins/forms/lib/forms";

interface Props {
  /** Left out: the `scope` forms' submissions (the shared inbox), with the form's name on each. */
  form?: Form;
  scope?: string[];
  status: "inbox" | "spam";
}
const { form, scope = [], status } = Astro.props;
const params = Astro.url.searchParams;
const q = (params.get("q") ?? "").slice(0, 200);
const page = Math.max(1, Number(params.get("page")) || 1);
const show = status === "inbox" && ["unread", "starred"].includes(params.get("show") ?? "") ? (params.get("show") as "unread" | "starred") : "all";
const days = [7, 30, 90].includes(Number(params.get("days"))) ? Number(params.get("days")) : 0;
const order = params.get("order") === "old" ? "old" : "new";
const perPage = PER_PAGE.includes(Number(params.get("per"))) ? Number(params.get("per")) : PAGE;
const view: View = status === "spam" ? "spam" : show === "all" ? "inbox" : show;
const where = form?.key ?? scope;
const { total, items } = submissions(where, view, q, page, { perPage, days, order });
const n = counts(where);
const names = form ? null : new Map(forms().map((f) => [f.key, f.name]));
const pages = Math.max(1, Math.ceil(total / perPage));
const date = (s: number) => new Intl.DateTimeFormat("en", { dateStyle: "medium", timeStyle: "short" }).format(s * 1000);
const preview = (s: Submission) =>
  Object.entries(s.data)
    .filter(([, v]) => [v].flat().join("").trim())
    .slice(0, 3)
    .map(([k, v]) => `${k}: ${[v].flat().join(", ")}`)
    .join(" · ")
    .slice(0, 160) || "(empty)";
const link = (over: Record<string, string | number>) => {
  const p = new URLSearchParams({ tab: status, ...(show !== "all" && { show }), ...(q && { q }), ...(days && { days: String(days) }), ...(order === "old" && { order }), ...(perPage !== PAGE && { per: String(perPage) }) });
  for (const [k, v] of Object.entries(over)) v === "" ? p.delete(k) : p.set(k, String(v));
  return `?${p}`;
};
const chip = (active: boolean) => `rounded-full border px-3 py-1 text-xs ${active ? "bg-foreground text-background" : "hover:bg-muted"}`;
const select = inputClass + " w-auto";
---

<div class="flex flex-col gap-4">
  {
    status === "inbox" && (
      <nav class="flex flex-wrap gap-2" aria-label="Show">
        <a class={chip(show === "all")} href={link({ show: "", page: "" })}>All ({n.inbox})</a>
        <a class={chip(show === "unread")} href={link({ show: "unread", page: "" })}>Unread ({n.unread})</a>
        <a class={chip(show === "starred")} href={link({ show: "starred", page: "" })}>Starred ({n.starred})</a>
      </nav>
    )
  }
  <div class="flex flex-col gap-2 lg:flex-row lg:items-center lg:justify-between">
    <form class="flex flex-wrap gap-2" method="get">
      <input type="hidden" name="tab" value={status} />
      {show !== "all" && <input type="hidden" name="show" value={show} />}
      <input class={inputClass + " w-56"} name="q" value={q} placeholder="Search submissions" aria-label="Search submissions" />
      <select class={select} name="days" aria-label="Date range">
        {[[0, "All time"], [7, "Last 7 days"], [30, "Last 30 days"], [90, "Last 90 days"]].map(([v, l]) => <option value={v} selected={v === days}>{l}</option>)}
      </select>
      <select class={select} name="order" aria-label="Order">
        <option value="new" selected={order === "new"}>Newest first</option>
        <option value="old" selected={order === "old"}>Oldest first</option>
      </select>
      <select class={select} name="per" aria-label="Per page">
        {PER_PAGE.map((p) => <option value={p} selected={p === perPage}>{p} / page</option>)}
      </select>
      <button class={button("outline")}>Apply</button>
    </form>
    {form && <a class={button("outline")} href={`/api/forms/${form.key}/export?status=${status}`} download>Export CSV</a>}
  </div>
  {status === "spam" && <p class="text-muted-foreground text-sm">Spam is kept, but nothing is emailed or sent on for it. Open one to see why it was flagged.</p>}
  {
    items.length === 0 ? (
      <p class="text-muted-foreground rounded-lg border p-6 text-center text-sm">
        {q || days ? "Nothing matches." : status === "spam" ? "No spam." : show === "unread" ? "All read." : show === "starred" ? "Nothing starred yet: star a submission to keep it here." : "No submissions yet. The Setup tab shows how to connect your form."}
      </p>
    ) : (
      <div class="flex flex-col gap-2" data-bulk-root>
        <div class="flex flex-wrap items-center gap-2 text-sm">
          <label class="flex items-center gap-2 px-1">
            <input type="checkbox" class="size-4" data-all aria-label="Select all on this page" /> <span class="text-muted-foreground" data-count>Select</span>
          </label>
          <span class="flex flex-wrap gap-2" data-bulk hidden>
            <button class={button("outline", "sm")} data-bulk-action="read">Mark read</button>
            <button class={button("outline", "sm")} data-bulk-action="unread">Mark unread</button>
            <button class={button("outline", "sm")} data-bulk-action="star">Star</button>
            <button class={button("outline", "sm")} data-bulk-action="unstar">Unstar</button>
            <button class={button("outline", "sm")} data-bulk-action={status === "spam" ? "inbox" : "spam"}>{status === "spam" ? "Not spam" : "Spam"}</button>
            <button class={button("destructive", "sm")} data-bulk-action="delete">Delete</button>
          </span>
        </div>
        <ul class="divide-y rounded-lg border">
          {items.map((s) => (
            <li class="hover:bg-muted flex items-center gap-3 pl-4 text-sm">
              <input type="checkbox" class="size-4 shrink-0" value={s.id} data-pick aria-label="Select" />
              <a href={`/forms/${s.formKey}/${s.id}`} class="flex min-w-0 flex-1 items-center justify-between gap-3 py-3 pr-4">
                <span class:list={["min-w-0 truncate", !s.read && status === "inbox" && "font-semibold"]}>
                  {s.starred && <span class="mr-1 text-amber-500" aria-label="Starred">★</span>}
                  {names && <span class="text-muted-foreground mr-2 text-xs font-normal">{names.get(s.formKey)}</span>}
                  {preview(s)}
                </span>
                <span class="text-muted-foreground flex shrink-0 items-center gap-2 text-xs">
                  {s.files.length > 0 && <span>{s.files.length} file{s.files.length > 1 ? "s" : ""}</span>}
                  {status === "spam" && <span class="rounded-full bg-amber-500/15 px-2 py-0.5 text-amber-700 dark:text-amber-300">score {s.score}</span>}
                  {date(s.createdAt)}
                </span>
              </a>
            </li>
          ))}
        </ul>
        <p role="alert" class="text-destructive text-sm empty:hidden" data-bulk-error></p>
      </div>
    )
  }
  {
    pages > 1 && (
      <nav class="flex items-center justify-between text-sm" aria-label="Pages">
        {page > 1 ? <a class={button("outline", "sm")} href={link({ page: page - 1 })}>Previous</a> : <span />}
        <span class="text-muted-foreground">Page {page} of {pages} · {total} total</span>
        {page < pages ? <a class={button("outline", "sm")} href={link({ page: page + 1 })}>Next</a> : <span />}
      </nav>
    )
  }
</div>

<script>
  import { post } from "@/lib/post";
  const root = document.querySelector<HTMLElement>("[data-bulk-root]");
  if (root) {
    const picks = [...root.querySelectorAll<HTMLInputElement>("[data-pick]")];
    const all = root.querySelector<HTMLInputElement>("[data-all]")!;
    const bar = root.querySelector<HTMLElement>("[data-bulk]")!;
    const count = root.querySelector<HTMLElement>("[data-count]")!;
    const chosen = () => picks.filter((p) => p.checked).map((p) => p.value);
    const sync = () => {
      const n = chosen().length;
      bar.hidden = !n;
      count.textContent = n ? `${n} selected` : "Select";
      all.checked = n === picks.length;
      all.indeterminate = n > 0 && n < picks.length;
    };
    all.addEventListener("change", () => (picks.forEach((p) => (p.checked = all.checked)), sync()));
    picks.forEach((p) => p.addEventListener("change", sync));
    root.querySelectorAll<HTMLButtonElement>("[data-bulk-action]").forEach((b) =>
      b.addEventListener("click", async () => {
        const ids = chosen();
        if (b.dataset.bulkAction === "delete" && !confirm(`Delete ${ids.length} submission${ids.length > 1 ? "s" : ""} and their files?`)) return;
        try {
          await post("/api/submissions", { action: b.dataset.bulkAction, ids });
          location.reload();
        } catch (e: any) {
          root.querySelector("[data-bulk-error]")!.textContent = e.message;
        }
      }),
    );
  }
</script>
