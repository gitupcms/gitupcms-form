---
import Admin from "@/layouts/Admin.astro";
import Inbox from "@/components/Inbox.astro";
import { tabList, tabTrigger } from "@/components/ui/island";
import { counts } from "@/plugins/forms/lib/forms";

const tab = Astro.url.searchParams.get("tab") === "spam" ? "spam" : "inbox";
const n = counts(null);
---

<Admin title="Inbox">
  <div class="flex flex-col gap-4">
    <div>
      <h1 class="text-lg font-medium tracking-tight">Inbox</h1>
      <p class="text-muted-foreground text-sm">Every form's submissions in one list, newest first.</p>
    </div>
    <nav class={tabList} aria-label="Status">
      <a href="?tab=inbox" class={tabTrigger} data-state={tab === "inbox" ? "active" : undefined}>Inbox{n.inbox ? ` (${n.inbox})` : ""}</a>
      <a href="?tab=spam" class={tabTrigger} data-state={tab === "spam" ? "active" : undefined}>Spam{n.spam ? ` (${n.spam})` : ""}</a>
    </nav>
    <Inbox status={tab} />
  </div>
</Admin>
