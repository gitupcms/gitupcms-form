---
import Admin from "@/layouts/Admin.astro";
import Inbox from "@/components/Inbox.astro";
import { forms } from "@/plugins/forms/lib/forms";

const workspace = Astro.locals.workspace;
const keys = forms(workspace.id).map((f) => f.key);
---

<Admin title="Inbox">
  <div class="flex flex-col gap-4">
    <div>
      <h1 class="text-lg font-medium tracking-tight">Inbox</h1>
      <p class="text-muted-foreground text-sm">Every form's submissions in {workspace.name}, in one list.</p>
    </div>
    <Inbox scope={keys} />
  </div>
</Admin>
