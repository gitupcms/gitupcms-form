---
import { Input } from "@/components/ui/input";
import Admin from "@/layouts/Admin.astro";
import { Button } from "@/components/ui/button";
import { SPAM_DAYS } from "@/plugins/forms/lib/forms";
---

<Admin title="Data requests">
  <div class="flex flex-col gap-6">
    <div>
      <h1 class="text-lg font-medium tracking-tight">Data requests</h1>
      <p class="text-muted-foreground text-sm">
        When someone asks what you store about them, or asks you to delete it (GDPR, KVKK), find their submissions by email across every form. Send them the
        export, or delete everything. Spam is deleted after {SPAM_DAYS} days anyway.
      </p>
    </div>
    <form class="flex flex-col gap-3 rounded-lg border p-4 sm:flex-row sm:items-end" data-find>
      <label class="flex flex-1 flex-col gap-1 text-sm">Email address <Input name="email" type="email" placeholder="name@example.com" required /></label>
      <Button type="submit">Find</Button>
    </form>
    <p role="status" class="text-sm empty:hidden" data-result></p>
    <ul class="divide-y rounded-lg border text-sm empty:hidden" data-list></ul>
    <div class="flex gap-2" data-actions hidden>
      <Button variant="outline" data-export>Download as JSON</Button>
      <Button variant="destructive" data-delete>Delete all</Button>
    </div>
  </div>
</Admin>

<script>
  import { post } from "@/lib/post";
  const finder = document.querySelector<HTMLFormElement>("[data-find]")!;
  const result = document.querySelector<HTMLElement>("[data-result]")!;
  const list = document.querySelector<HTMLElement>("[data-list]")!;
  const actions = document.querySelector<HTMLElement>("[data-actions]")!;
  let email = "";
  let found: any[] = [];

  const show = (message: string, error = false) => {
    result.className = `text-sm empty:hidden ${error ? "text-destructive" : "text-muted-foreground"}`;
    result.textContent = message;
  };
  finder.addEventListener("submit", async (e) => {
    e.preventDefault();
    email = String(new FormData(finder).get("email"));
    try {
      found = await post("/api/data-requests", { email, action: "find" });
    } catch (err: any) {
      return show(err.message, true);
    }
    list.replaceChildren(
      ...found.map((s) => {
        const li = document.createElement("li");
        li.className = "flex justify-between gap-3 px-4 py-2";
        const a = Object.assign(document.createElement("a"), { href: `/forms/${s.formKey}/${s.id}`, className: "hover:underline", textContent: `${s.form}${s.status === "spam" ? " (spam)" : ""}` });
        const date = Object.assign(document.createElement("span"), { className: "text-muted-foreground", textContent: new Date(s.submittedAt).toLocaleString() });
        li.append(a, date);
        return li;
      }),
    );
    actions.hidden = !found.length;
    show(found.length ? `Found ${found.length} submission${found.length === 1 ? "" : "s"} for ${email}.` : `Nothing stored for ${email}.`);
  });
  document.querySelector("[data-export]")!.addEventListener("click", () => {
    const blob = new Blob([JSON.stringify({ email, exportedAt: new Date().toISOString(), submissions: found }, null, 2)], { type: "application/json" });
    const a = Object.assign(document.createElement("a"), { href: URL.createObjectURL(blob), download: "data-request.json" });
    a.click();
    URL.revokeObjectURL(a.href);
  });
  document.querySelector("[data-delete]")!.addEventListener("click", async () => {
    if (!confirm(`Delete ${found.length} submission(s) and their files for ${email}? This cannot be undone.`)) return;
    try {
      const { deleted } = await post("/api/data-requests", { email, action: "delete" });
      list.replaceChildren();
      actions.hidden = true;
      found = [];
      show(`Deleted ${deleted} submission${deleted === 1 ? "" : "s"}.`);
    } catch (err: any) {
      show(err.message, true);
    }
  });
</script>
