---
import { Input } from "@/components/ui/input";
import Admin from "@/layouts/Admin.astro";
import { Button } from "@/components/ui/button";
import { admins, invites } from "@/lib/team";

const me = Astro.locals.admin;
const date = (d: string | number) => new Intl.DateTimeFormat("en", { dateStyle: "medium" }).format(typeof d === "number" ? d * 1000 : new Date(d));
---

<Admin title="Team">
  <div class="flex flex-col gap-6">
    <div>
      <h1 class="text-lg font-medium tracking-tight">Team</h1>
      <p class="text-muted-foreground text-sm">Every admin can read submissions, change settings and invite or remove other admins.</p>
    </div>
    <ul class="divide-y rounded-lg border">
      {
        admins().map((a) => (
          <li class="flex items-center justify-between gap-3 px-4 py-3 text-sm">
            <span class="flex flex-col">
              <strong class="font-medium">{a.name}{a.id === me.id && " (you)"}</strong>
              <span class="text-muted-foreground text-xs">{a.email} · since {date(a.createdAt)}</span>
            </span>
            {a.id !== me.id && <Button size="sm" variant="outline" data-action="remove" data-id={a.id} data-confirm={`Remove ${a.email}?`}>Remove</Button>}
          </li>
        ))
      }
      {
        invites().map((i) => (
          <li class="flex items-center justify-between gap-3 px-4 py-3 text-sm">
            <span class="flex flex-col">
              <span>{i.email}</span>
              <span class="text-muted-foreground text-xs">Invited · link works until {date(i.expiresAt)}</span>
            </span>
            <Button size="sm" variant="ghost" data-action="revoke" data-token={i.token}>Cancel invite</Button>
          </li>
        ))
      }
    </ul>
    <form class="flex flex-col gap-3 rounded-lg border p-4 sm:flex-row sm:items-end" data-invite>
      <label class="flex flex-1 flex-col gap-1 text-sm">Invite an admin <Input name="email" type="email" placeholder="name@example.com" required /></label>
      <Button type="submit">Invite</Button>
    </form>
    <p role="status" class="text-sm break-all empty:hidden" data-result></p>
  </div>
</Admin>

<script>
  const result = document.querySelector<HTMLElement>("[data-result]")!;
  const call = async (body: object) => {
    const res = await fetch("/api/team", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(body) });
    const json = await res.json().catch(() => ({ error: "Unexpected response." }));
    result.className = res.ok ? "text-sm break-all" : "text-destructive text-sm";
    if (!res.ok) result.textContent = json.error;
    return res.ok ? json.data : null;
  };
  const form = document.querySelector<HTMLFormElement>("[data-invite]")!;
  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    const data = await call({ action: "invite", email: new FormData(form).get("email") });
    if (data) {
      result.textContent = `${data.emailed ? "Invite sent. " : "No email server is set up: send this link yourself. "}Link: ${data.link}`;
      form.reset();
    }
  });
  document.querySelectorAll<HTMLButtonElement>("[data-action]").forEach((b) =>
    b.addEventListener("click", async () => {
      if (b.dataset.confirm && !confirm(b.dataset.confirm)) return;
      if (await call({ action: b.dataset.action, id: b.dataset.id, token: b.dataset.token })) location.reload();
    }),
  );
</script>
