{
  "name": "@gitupcms/forms",
  "version": "0.1.0",
  "description": "Self-hosted backend for plain HTML forms: point action at it, get an inbox, email, webhooks, file uploads and spam filtering.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gitupcms/gitupcms-form.git"
  },
  "homepage": "https://github.com/gitupcms/gitupcms-form",
  "bin": {
    "gitupcms-forms": "bin/gitupcms-forms.mjs"
  },
  "files": [
    "bin",
    "dist",
    "src",
    ".env.example"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "start": "node dist/server/entry.mjs",
    "check": "astro check",
    "test": "node --test \"src/**/*.test.ts\"",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@astrojs/compiler-rs": "0.5.2",
    "@astrojs/node": "^11.1.9",
    "@data-slot/select": "^1.1.3",
    "@lucide/astro": "^1.66.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.4",
    "bejamas": "^0.6.1",
    "better-auth": "^1.7.15",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/compiler": "4.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "8.3.5"
  }
}
